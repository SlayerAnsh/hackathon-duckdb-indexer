# Indexer credentials stay on the server. The key is optional and unused by default:
# only BACKFILL_MODE=query, SYNC_USE_API_KEY=true or FILL_USE_API_KEY=true send it.
SYNC_PAUSED=false
TIRAMISU_API_KEY=
# Blank indexes every entity. Optionally copy the demo expression from README in single quotes.
INDEX_EXPRESSION=
# Public logs and metadata never use the API key.
PUBLIC_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
# logs replays public operation logs. query opts into the legacy broad scan.
BACKFILL_MODE=logs
# Attributes for log derived rows are filled newest first on the anonymous public RPC budget.
FILL_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
# true sends the API key with fills and spends the monthly quota.
FILL_USE_API_KEY=false
# true restores keyed live sync (key lookups on ARKIV_RPC_URL) and spends the monthly quota.
SYNC_USE_API_KEY=false
# Keys per fill query (at most 50) and the pause between fill queries.
FILL_CHUNK=50
FILL_INTERVAL_MS=4000
# Keyed RPC, used only with SYNC_USE_API_KEY=true or BACKFILL_MODE=query.
ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network

# Public RPC, never put credentials here.
NEXT_PUBLIC_TIRAMISU_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
# Block explorer for creator and owner address links (address pages live at <url>/address/<0x address>).
NEXT_PUBLIC_EXPLORER_URL=https://tiramisu.explorer.arkiv.network

# Optional demo profile. Use a funded synthetic testnet wallet only.
DEMO_PRIVATE_KEY=
DEMO_AGENT_ADDRESSES=

# Host path for the indexer data (docker-compose.dokploy.yml uses a named volume instead)
INDEX_DATA_PATH=./data
