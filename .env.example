# Indexer (apps/indexer). Defaults live in apps/indexer/src/config.ts.

# true serves the existing store with no RPC calls and needs no API key.
SYNC_PAUSED=false
# Optional Arkiv API key, server only. The indexer sends it only with BACKFILL_MODE=query,
# SYNC_USE_API_KEY=true or FILL_USE_API_KEY=true. The web server also uses it for the /api/rpc read proxy.
# Never put it in a NEXT_PUBLIC_ variable or a build argument.
ARKIV_API_KEY=
# Arkiv query expression to index. Blank indexes every entity. Keep single quotes so Compose preserves $creator,
# for example INDEX_EXPRESSION='$creator = addr(0x...)'. Changing it needs a fresh data directory.
INDEX_EXPRESSION=
# Chain: Rabdi testnet (chain 7794095, see https://stage.docs.arkiv.network). The indexer reads the chain ID from
# the RPC and stores it with the data, so pointing the RPC URLs at another chain needs a fresh data directory.
# Public RPC for log replay, live logs and chain metadata. Never keyed.
PUBLIC_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
# scan reads the latest state in key order on the anonymous budget (Rabdi serves logs only for about the last
# 1,000 blocks). query runs the same scan with the API key. logs replays public operation logs from genesis and
# only works on a chain that serves old logs.
BACKFILL_MODE=scan
# RPC for attribute fills, newest first, on the anonymous public budget.
FILL_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
# true sends the API key with fills and spends the monthly quota.
FILL_USE_API_KEY=false
# true restores keyed live sync (key lookups on ARKIV_RPC_URL) and spends the monthly quota.
SYNC_USE_API_KEY=false
# Keys per fill query (at most 50).
FILL_CHUNK=50
# Pause between fill queries in milliseconds.
FILL_INTERVAL_MS=4000
# Keyed RPC, used only with SYNC_USE_API_KEY=true or BACKFILL_MODE=query.
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
# Host path for the index data in docker-compose.yml (docker-compose.dokploy.yml uses a named volume instead).
INDEX_DATA_PATH=./data

# Web app (apps/web). Next.js reads env files from apps/web, so copy this to apps/web/.env.local for bun dev.

# Upstream for the /data proxy. Compose sets http://indexer:8080 itself. For bun dev, point it at your
# indexer (http://localhost:8080) or at the hosted indexer covering all Rabdi data:
# INDEXER_URL=https://arkiv-sql-indexer.dokploy.anshudhar.dev
# Public RPC for wallet signing, server writes and the /api/rpc upstream. Embedded at build time, never put credentials here.
NEXT_PUBLIC_ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
# Block explorer for creator and owner address links (address pages live at <url>/address/<0x address>).
NEXT_PUBLIC_EXPLORER_URL=https://rabdi.explorer.arkiv.network

# Widgets and dashboards (optional). Blank NEXT_PUBLIC_PRIVY_APP_ID turns them off; the Playground still works.
NEXT_PUBLIC_PRIVY_APP_ID=
# Server only. Privy verification and session signing. Never prefix with NEXT_PUBLIC_.
PRIVY_APP_SECRET=
# Server only. App wallet that creates every widget, dashboard and link and keeps Featured dashboards live.
# Use a funded synthetic testnet wallet only. The browser discovers its address through /api/dash/config.
DASHBOARD_PRIVATE_KEY=
