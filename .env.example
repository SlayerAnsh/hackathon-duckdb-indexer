# Indexer credentials stay on the server.
TIRAMISU_API_KEY=
# Copy the demo expression from README inside single quotes to preserve $creator.
INDEX_EXPRESSION=
ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network

# Public RPC, never put credentials here.
NEXT_PUBLIC_TIRAMISU_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network

# Optional demo profile. Use a funded synthetic testnet wallet only.
DEMO_PRIVATE_KEY=
DEMO_AGENT_ADDRESSES=

# Host path for the indexer data (Dokploy: ../files/data)
INDEX_DATA_PATH=./data
